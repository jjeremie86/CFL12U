# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run `npm run seed:coaches`. Never expose this to the
# browser or commit it — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
